// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  masteryStates KnowledgeMasteryState[]
  diagnosticQuizzes DiagnosticQuizRecord[]
  storySession SystemStorySession?
  storyMessages StoryChatMessage[]
  cardBattleRecords CardBattleRecord[]
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  source     String? @default("manual") // "manual" | "diagnostic"
  
  createdAt DateTime @default(now())
}

// 知识点贝叶斯/掌握度状态模型 (0:未诊, 1:薄弱漏洞, 2:初步掌握, 3:稳固掌握)
model KnowledgeMasteryState {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject      String   // "math" | "physics"等
  tagName      String   // 规范标签名称，如 "平抛运动"
  masteryState Int      @default(0) // 0: unassessed, 1: deficit, 2: developing, 3: mastered
  probability  Float    @default(0.0) // BKT/贝叶斯推算概率 0.0 - 1.0

  totalTested  Int      @default(0)
  correctCount Int      @default(0)
  guessedCount Int      @default(0)

  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, subject, tagName])
  @@index([userId, subject])
}

// 诊断测试历史记录表
model DiagnosticQuizRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String   // "math" | "physics"
  grade       String   // 年级/册别
  chapters    String   // JSON string: 所选章节数组
  score       Int      // 最终得分
  totalCount  Int      // 总题数
  detailJson  String   // 详细答题记录 JSON

  createdAt   DateTime @default(now())
}

// 系统流剧情会话（宿主状态，每用户一条）
model SystemStorySession {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage            Int      @default(1) // 当前剧情阶段 1:月考倒计时 2:月考战役 3:奥赛集训 4:黑科技课题组
  stageTitle       String   @default("阶段一：月考倒计时")
  points           Int      @default(0) // 学神积分 SP
  level            Int      @default(1) // 宿主等级
  subject          String   @default("physics") // 当前剧情学科 "math" | "physics"
  grade            String   @default("高一上") // 当前剧情年级
  currentEventJson String? // 当前进行中的事件+题目 JSON
  summary          String? // 更早剧情的 AI 压缩摘要（L3 记忆）
  eventCount       Int      @default(0) // 已完成事件数
  streak           Int      @default(0) // 连续答对数
  messages         StoryChatMessage[]

  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// 系统流对话历史
model StoryChatMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  session          SystemStorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role             String   // "system" | "user"
  type             String   // "broadcast" | "event" | "question" | "answer" | "settle" | "dialogue"
  content          String   // 消息正文
  questionDataJson String? // 内嵌题目数据（如有）

  createdAt        DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

// 卡牌战斗战报记录
model CardBattleRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject        String   // "math" | "physics"
  result         String   // "victory" | "defeat"
  stagesCleared  Int      @default(0)
  totalStages    Int      @default(8)
  score          Int      @default(0)
  deckJson       String   // 卡组快照 JSON

  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

